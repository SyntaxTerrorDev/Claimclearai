GEMINI_API_KEY="Paste your gemini api key here"
# Optional fallback LLM when Gemini fails (https://console.groq.com/keys)
GROQ_API_KEY=""
# Shared secret: the web app sends it as X-Backend-Token.
# Put the same value in apps/web/.env.local as BACKEND_SECRET_TOKEN.
BACKEND_SECRET_TOKEN="change-me"
# Optional ops ping to Discord. Never contains patient data.
# DISCORD_WEBHOOK_URL=""
# Mask patient identifiers before text is sent to the LLM (default on). Set off only for local debugging.
# PHI_SHIELD="on"
# Only needed if tesseract is not on PATH, e.g. C:\Program Files\Tesseract-OCR\tesseract.exe
# TESSERACT_CMD=""
# Extra browser origins allowed to call this service directly (comma-separated), e.g. a laptop on the hackathon Wi-Fi
# FRONTEND_ORIGINS="http://192.168.1.20:3000"
# Gemini models tried in order when one is busy (all free on the same key)
# GEMINI_MODELS="gemini-3.5-flash-lite,gemini-3.8-flash,gemini-3.6-flash,gemini-3.1-flash-lite"
